{
  "name": "kledo-mcp",
  "version": "0.3.0",
  "description": "Independent, minimal read-only MCP server for Kledo",
  "mcpName": "io.github.kevzakaria/kledo-mcp",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevzakaria/kledo-mcp.git"
  },
  "homepage": "https://github.com/kevzakaria/kledo-mcp#readme",
  "keywords": [
    "kledo",
    "mcp",
    "model-context-protocol",
    "accounting",
    "finance"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "kledo-mcp": "./dist/bin/stdio.js"
  },
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "dist",
    "docs/architecture.md",
    "docs/assets/kledo-mcp-banner.png",
    "docs/client-setup.md",
    "docs/configuration.md",
    "docs/kledo-document-cycle-map.md",
    "docs/releasing.md",
    "docs/tool-reference.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "mcp-inspector.json",
    "server.json",
    "scripts/setup.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "config:check": "node --env-file=.env dist/bin/check-config.js",
    "debug:mcp": "npm run build && mcp-inspector --config mcp-inspector.json",
    "debug:mcp:check": "npm run build && mcp-inspector --cli --config mcp-inspector.json --server kledo-fixture --method tools/list --strict --format json",
    "changelog:check": "node scripts/changelog.mjs check",
    "pretest": "npm run build",
    "prepack": "npm run changelog:check && npm run build",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:release && npm run test:wizard",
    "test:release": "node --test test/release-metadata.node.mjs test/changelog.node.mjs",
    "test:trace": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/report-sales-by-person.test.ts -t \"reuses a tenant-scoped salesperson mapping after the gateway restarts\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:dormant": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/report-dormant-customers.test.ts --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:price": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/report-item-price-analysis.test.ts -t \"keeps catalog prices\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:receivable": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/report-receivable-by-invoice.test.ts -t \"returns invoice numbers\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:orders": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/report-sales-order-kpi.test.ts -t \"sums every page-level\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:lineage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/get-sales-invoice-lineage.test.ts --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:purchase-lineage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/get-purchase-invoice-lineage.test.ts --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:document-number": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/get-by-document-number.test.ts -t \"returns the exact Sales Invoice\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:print-document": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/mcp/get-sales-invoice-print-document.test.ts -t \"retrieves a bounded PDF\" --reporter=default --disableConsoleIntercept --no-color",
    "test:trace:routing": "NODE_OPTIONS=--disable-warning=ExperimentalWarning KLEDO_TEST_TRACE=1 vitest run test/debug/query-routing-trace.test.ts --reporter=default --disableConsoleIntercept --no-color",
    "test:wizard": "node test/setup-wizard.mjs",
    "test:watch": "vitest",
    "warmup": "npm run build && node --disable-warning=ExperimentalWarning --env-file=.env dist/bin/warmup-identities.js",
    "start": "node dist/bin/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/inspector": "2.4.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
