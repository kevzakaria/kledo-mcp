# Placeholder values only. Never commit a real Kledo token.
KLEDO_API_BASE_URL=https://your-kledo-api-host/api/v1/
KLEDO_API_TOKEN=<your-read-only-kledo-token>
# Persistent identity storage is opt-in. The default keeps identities in memory only.
KLEDO_IDENTITY_CACHE=memory
# Used only when KLEDO_IDENTITY_CACHE=sqlite. Defaults to the private OS state directory.
# KLEDO_STATE_DIR=/absolute/path/to/private/kledo-mcp-state
# Optional sanitized diagnostics on stderr. Enable only while debugging.
# KLEDO_DEBUG=1
